{
  "name": "thoughts-box",
  "version": "0.0.0",
  "description": "思绪盒子 Thoughts Box — 本地优先的个人思绪整理工具（V0）",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <27"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start:server": "node src/server/index.ts",
    "start:web": "vite",
    "build": "vite build && tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "publish:oss": "node scripts/publish-oss.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "license": "AGPL-3.0-only"
}
